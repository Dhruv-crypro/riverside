# Database (Prisma/PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/riverside?schema=public"

# API
API_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# Supabase (optional / future integrations)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_your_project_key

# Clerk (optional in dev due keyless mode, required in stable/prod environments)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
